# Template only — no real values here. Put real secrets in .env, which is gitignored.

# Telegram — from @BotFather
TELEGRAM_BOT_TOKEN=

# Postgres connection string (URI). Supabase, Neon, or local — any of them work.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# LLM keys. LiteLLM reads these by name; Groq is the fallback and may be left blank.
GEMINI_API_KEY=
GROQ_API_KEY=

# Who may talk to the bot. Comma-separated *numeric* Telegram user IDs, not @usernames.
ALLOWED_TELEGRAM_IDS=

# IANA timezone used to resolve "tomorrow at 8".
TIMEZONE=Asia/Kolkata

# Optional overrides
MODEL=gemini/gemini-3.5-flash-lite
FALLBACK_MODEL=groq/llama-3.3-70b-versatile
